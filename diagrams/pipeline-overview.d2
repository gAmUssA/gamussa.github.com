direction: right

title: {
  label: "Real-Time Crypto Analytics Pipeline"
  style.font-size: 24
  style.bold: true
  near: top-center
}

coingecko: CoinGecko API {
  style.fill: "#f8fafc"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
  style.bold: true
}

connector: HTTP Source\nConnector {
  style.fill: "#f8fafc"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
}

sr: Schema\nRegistry {
  style.fill: "#f1f5f9"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
  shape: cylinder
}

kafka: Apache Kafka {
  style.fill: "#334155"
  style.stroke: "#475569"
  style.font-color: "#f1f5f9"
  style.bold: true

  topics: {
    crypto-prices {
      shape: queue
      style.fill: "#475569"
      style.font-color: "#f1f5f9"
    }
  }
}

flink: Apache Flink {
  style.fill: "#f8fafc"
  style.stroke: "#4F46E5"
  style.font-color: "#4F46E5"
  style.bold: true

  sql: Flink SQL {
    style.fill: "#f1f5f9"
    style.stroke: "#6366F1"
    style.font-color: "#4F46E5"
  }
}

derived: Derived Topics {
  style.fill: "#334155"
  style.stroke: "#475569"
  style.font-color: "#f1f5f9"

  alerts: price-alerts {
    shape: queue
    style.fill: "#475569"
    style.font-color: "#f1f5f9"
  }
  trends: crypto-trends {
    shape: queue
    style.fill: "#475569"
    style.font-color: "#f1f5f9"
  }
}

tableflow: Tableflow {
  style.fill: "#f8fafc"
  style.stroke: "#0891b2"
  style.font-color: "#0891b2"
  style.bold: true
}

iceberg: Iceberg\nTables {
  shape: cylinder
  style.fill: "#f1f5f9"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
}

duckdb: DuckDB {
  style.fill: "#f8fafc"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
  style.bold: true
}

coingecko -> connector: REST API
connector -> sr: validate
connector -> kafka.topics.crypto-prices: produce
kafka.topics.crypto-prices -> flink.sql: stream
flink.sql -> derived.alerts: alerts
flink.sql -> derived.trends: trends
kafka.topics.crypto-prices -> tableflow
derived.alerts -> tableflow
derived.trends -> tableflow
tableflow -> iceberg: materialize
iceberg -> duckdb: query
