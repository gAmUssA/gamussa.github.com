direction: right

title: {
  label: "Module 4: Flink Stream Processing"
  style.font-size: 20
  style.bold: true
  near: top-center
}

kafka: Kafka {
  style.fill: "#1a202c"
  style.stroke: "#334155"
  style.font-color: "#f8fafc"

  input: crypto-prices {
    shape: queue
    style.fill: "#334155"
    style.font-color: "#f8fafc"
  }
}

flink: Flink SQL {
  style.fill: "#EEF2FF"
  style.stroke: "#4F46E5"
  style.font-color: "#4338CA"
  style.bold: true
  style.double-border: true

  explode: Explode\nnested JSON
  alerts_q: Price alerts\nSQL
  trends_q: Trend analysis\nSQL
}

output: Output Topics {
  style.fill: "#1a202c"
  style.stroke: "#334155"
  style.font-color: "#f8fafc"

  exploded: crypto-prices\n-exploded {
    shape: queue
    style.fill: "#334155"
    style.font-color: "#f8fafc"
  }
  alerts: price-alerts {
    shape: queue
    style.fill: "#7f1d1d"
    style.font-color: "#fca5a5"
  }
  trends: crypto-trends {
    shape: queue
    style.fill: "#1e3a5f"
    style.font-color: "#93c5fd"
  }
}

tableflow: Tableflow {
  style.fill: "#ECFEFF"
  style.stroke: "#0891b2"
  style.font-color: "#0e7490"
  style.bold: true
}

iceberg: Iceberg {
  shape: cylinder
  style.fill: "#F0FDF4"
  style.stroke: "#16a34a"
  style.font-color: "#166534"
}

kafka.input -> flink.explode: stream {
  style.stroke: "#4F46E5"
}
flink.explode -> output.exploded
flink.explode -> flink.alerts_q
flink.explode -> flink.trends_q
flink.alerts_q -> output.alerts: "price > threshold" {
  style.stroke: "#dc2626"
}
flink.trends_q -> output.trends: "rolling window" {
  style.stroke: "#2563eb"
}
output.exploded -> tableflow
output.alerts -> tableflow
output.trends -> tableflow
tableflow -> iceberg: materialize
