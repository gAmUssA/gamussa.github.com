direction: right

title: {
  label: "Module 4: Flink Stream Processing"
  style.font-size: 20
  style.bold: true
  near: top-center
}

kafka: Kafka {
  style.fill: "#334155"
  style.stroke: "#475569"
  style.font-color: "#f1f5f9"

  input: crypto-prices {
    shape: queue
    style.fill: "#475569"
    style.font-color: "#f1f5f9"
  }
}

flink: Flink SQL {
  style.fill: "#f8fafc"
  style.stroke: "#4F46E5"
  style.font-color: "#4F46E5"
  style.bold: true
  style.double-border: true

  explode: Explode\nnested JSON {
    style.fill: "#f1f5f9"
    style.stroke: "#94a3b8"
    style.font-color: "#475569"
  }
  alerts_q: Price alerts\nSQL {
    style.fill: "#f1f5f9"
    style.stroke: "#94a3b8"
    style.font-color: "#475569"
  }
  trends_q: Trend analysis\nSQL {
    style.fill: "#f1f5f9"
    style.stroke: "#94a3b8"
    style.font-color: "#475569"
  }
}

output: Output Topics {
  style.fill: "#334155"
  style.stroke: "#475569"
  style.font-color: "#f1f5f9"

  exploded: crypto-prices\n-exploded {
    shape: queue
    style.fill: "#475569"
    style.font-color: "#f1f5f9"
  }
  alerts: price-alerts {
    shape: queue
    style.fill: "#475569"
    style.font-color: "#f1f5f9"
  }
  trends: crypto-trends {
    shape: queue
    style.fill: "#475569"
    style.font-color: "#f1f5f9"
  }
}

tableflow: Tableflow {
  style.fill: "#f8fafc"
  style.stroke: "#0891b2"
  style.font-color: "#0891b2"
  style.bold: true
}

iceberg: Iceberg {
  shape: cylinder
  style.fill: "#f1f5f9"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
}

kafka.input -> flink.explode: stream {
  style.stroke: "#4F46E5"
}
flink.explode -> output.exploded
flink.explode -> flink.alerts_q
flink.explode -> flink.trends_q
flink.alerts_q -> output.alerts {
  style.stroke: "#94a3b8"
}
flink.trends_q -> output.trends {
  style.stroke: "#94a3b8"
}
output.exploded -> tableflow
output.alerts -> tableflow
output.trends -> tableflow
tableflow -> iceberg: materialize
