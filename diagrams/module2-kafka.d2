direction: right

title: {
  label: "Module 2: Kafka Data Ingestion"
  style.font-size: 20
  style.bold: true
  near: top-center
}

coingecko: CoinGecko\nREST API {
  style.fill: "#f8fafc"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
  style.bold: true
}

connector: HTTP Source\nConnector {
  style.fill: "#f8fafc"
  style.stroke: "#4F46E5"
  style.font-color: "#4F46E5"
  style.double-border: true
}

sr: Schema Registry {
  style.fill: "#f1f5f9"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
  shape: cylinder
}

kafka: Confluent Cloud Kafka {
  style.fill: "#334155"
  style.stroke: "#475569"
  style.font-color: "#f1f5f9"
  style.bold: true

  crypto-prices: crypto-prices {
    shape: queue
    style.fill: "#475569"
    style.font-color: "#f1f5f9"
  }
}

coingecko -> connector: "JSON\n/coins/markets" {
  style.stroke: "#94a3b8"
}
connector -> sr: "AVRO\nvalidation" {
  style.stroke: "#94a3b8"
}
connector -> kafka.crypto-prices: "produce\nevents" {
  style.stroke: "#4F46E5"
  style.bold: true
}
