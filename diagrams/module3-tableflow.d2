direction: right

title: {
  label: "Module 3: Tableflow & Iceberg"
  style.font-size: 20
  style.bold: true
  near: top-center
}

kafka: Kafka Topics {
  style.fill: "#1a202c"
  style.stroke: "#334155"
  style.font-color: "#f8fafc"
  style.bold: true

  topic: crypto-prices {
    shape: queue
    style.fill: "#334155"
    style.font-color: "#f8fafc"
  }
}

tableflow: Tableflow {
  style.fill: "#ECFEFF"
  style.stroke: "#0891b2"
  style.font-color: "#0e7490"
  style.bold: true
  style.double-border: true
}

iceberg: Iceberg Tables {
  style.fill: "#F0FDF4"
  style.stroke: "#16a34a"
  style.font-color: "#166534"
  shape: cylinder
  style.bold: true
}

catalog: Iceberg REST\nCatalog {
  style.fill: "#EEF2FF"
  style.stroke: "#4F46E5"
  style.font-color: "#4338CA"
}

duckdb: DuckDB {
  style.fill: "#FEF3C7"
  style.stroke: "#F59E0B"
  style.font-color: "#92400e"
  style.bold: true
}

kafka.topic -> tableflow: "materialize" {
  style.stroke: "#0891b2"
  style.bold: true
}
tableflow -> iceberg: "Iceberg\nformat" {
  style.stroke: "#16a34a"
}
iceberg -> catalog: "register"
catalog -> duckdb: "SQL\nqueries" {
  style.stroke: "#F59E0B"
  style.bold: true
}
