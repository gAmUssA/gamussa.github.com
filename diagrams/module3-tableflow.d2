direction: right

title: {
  label: "Module 3: Tableflow & Iceberg"
  style.font-size: 20
  style.bold: true
  near: top-center
}

kafka: Kafka Topics {
  style.fill: "#334155"
  style.stroke: "#475569"
  style.font-color: "#f1f5f9"
  style.bold: true

  topic: crypto-prices {
    shape: queue
    style.fill: "#475569"
    style.font-color: "#f1f5f9"
  }
}

tableflow: Tableflow {
  style.fill: "#f8fafc"
  style.stroke: "#0891b2"
  style.font-color: "#0891b2"
  style.bold: true
  style.double-border: true
}

iceberg: Iceberg Tables {
  style.fill: "#f1f5f9"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
  shape: cylinder
  style.bold: true
}

catalog: Iceberg REST\nCatalog {
  style.fill: "#f8fafc"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
}

duckdb: DuckDB {
  style.fill: "#f8fafc"
  style.stroke: "#94a3b8"
  style.font-color: "#475569"
  style.bold: true
}

kafka.topic -> tableflow: "materialize" {
  style.stroke: "#0891b2"
  style.bold: true
}
tableflow -> iceberg: "Iceberg\nformat" {
  style.stroke: "#94a3b8"
}
iceberg -> catalog: "register"
catalog -> duckdb: "SQL\nqueries" {
  style.stroke: "#4F46E5"
  style.bold: true
}
